# 本地运行用：复制本文件为 .env（node server.js）或 .dev.vars（npx wrangler dev），填入一种 AI 接口密钥。
# 线上（Cloudflare）不要上传这些文件，请在 Cloudflare 控制台的「变量和机密」里设置同名变量。

# ---- 方案 A：Anthropic Claude（推荐）----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- 方案 B：OpenAI 兼容的视觉模型（OpenAI / 通义千问 VL / 智谱 GLM-4V / 豆包 等）----
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_JSON_MODE=true

# 访问码：设置后，上传照片时必须输入它才能调用 AI（公开部署强烈建议设置，防止额度被刷）
ACCESS_CODE=

MAX_OUTPUT_TOKENS=16000
PORT=5173
